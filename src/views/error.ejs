<%- include('partials/header', { title: title || 'Ошибка' }) %>
<%- include('partials/navbar') %>

<main class="flex-grow flex items-center justify-center py-16 px-4 bg-slate-50">
  <div class="max-w-md w-full bg-white rounded-3xl p-8 border border-zinc-200 shadow-xl text-center">
    
    <div class="w-16 h-16 rounded-2xl bg-orange-100 text-orange-600 mx-auto flex items-center justify-center text-2xl mb-4 font-bold">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <h1 class="text-xl font-extrabold text-zinc-900 mb-2">
      <%= typeof title !== 'undefined' ? title : 'Произошла ошибка' %>
    </h1>

    <p class="text-xs text-zinc-600 leading-relaxed mb-6">
      <%= typeof message !== 'undefined' ? message : 'Запрошенная страница не найдена или возникла непредвиденная ошибка.' %>
    </p>

    <div class="flex items-center justify-center gap-3">
      <a href="<%= typeof backUrl !== 'undefined' ? backUrl : '/' %>" class="bg-dark-950 hover:bg-dark-800 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition flex items-center gap-2">
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Вернуться назад</span>
      </a>

      <a href="/" class="bg-orange-600 hover:bg-orange-500 text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-lg shadow-orange-600/30 transition">
        На главную
      </a>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
