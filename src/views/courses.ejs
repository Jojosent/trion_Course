<%- include('partials/header', { title: 'Каталог курсов — Trion Academy' }) %>
<%- include('partials/navbar') %>

<main class="flex-grow py-12 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl font-extrabold text-zinc-900 tracking-tight sm:text-4xl">Все доступные курсы</h1>
      <p class="mt-3 text-sm text-zinc-600">
        Выберите интересующее вас направление. Каждый урок содержит подробные теоретические материалы и защищенный видеоконтент.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% courses.forEach(course => { %>
        <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden shadow-sm hover-lift flex flex-col group">
          
          <div class="relative h-48 w-full overflow-hidden bg-zinc-900">
            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
            <div class="absolute inset-0 bg-gradient-to-t from-dark-950/80 via-transparent to-transparent"></div>
            
            <div class="absolute top-3 left-3">
              <span class="bg-orange-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg uppercase tracking-wide">
                <%= course.category %>
              </span>
            </div>

            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-zinc-200 font-medium">
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-layer-group text-orange-400"></i> <%= course.lessonsCount %> уроков</span>
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-signal text-orange-400"></i> <%= course.level %></span>
            </div>
          </div>

          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-zinc-900 mb-2 group-hover:text-orange-600 transition-colors">
                <%= course.title %>
              </h3>
              <p class="text-xs text-zinc-600 leading-relaxed mb-4 line-clamp-3">
                <%= course.description %>
              </p>
            </div>

            <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-zinc-900 text-white flex items-center justify-center text-xs font-bold">
                  <%= course.authorName ? course.authorName.charAt(0) : 'T' %>
                </div>
                <span class="text-xs font-medium text-zinc-700 truncate max-w-[130px]"><%= course.authorName %></span>
              </div>

              <a href="/courses/<%= course.id %>" class="inline-flex items-center gap-1 text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 px-3.5 py-2 rounded-xl transition">
                <span>Обучение</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>

          </div>

        </div>
      <% }) %>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
