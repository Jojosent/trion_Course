<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 bg-slate-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center justify-between pb-6 mb-8 border-b border-zinc-200">
      <div>
        <a href="/teacher/courses/<%= course.id %>/edit" class="text-xs text-zinc-500 hover:text-orange-600 transition flex items-center gap-1.5 mb-2">
          <i class="fa-solid fa-arrow-left"></i> Назад к курсу: <%= course.title %>
        </a>
        <h1 class="text-2xl font-extrabold text-zinc-900 tracking-tight">
          <%= lesson && lesson.id ? 'Редактирование урока' : 'Добавление нового урока' %>
        </h1>
      </div>
    </div>

    <% if (error) { %>
      <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="bg-white rounded-3xl p-8 border border-zinc-200 shadow-sm">
      <form action="<%= lesson && lesson.id ? `/teacher/lessons/${lesson.id}/edit` : `/teacher/courses/${course.id}/lessons` %>" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
          <div class="sm:col-span-8">
            <label for="title" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">Название урока</label>
            <input type="text" id="title" name="title" required value="<%= lesson ? lesson.title : '' %>" placeholder="Например: Урок 1: Введение и архитектура"
                   class="block w-full px-4 py-2.5 bg-slate-50 border border-zinc-300 rounded-xl text-xs text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 transition">
          </div>

          <div class="sm:col-span-2">
            <label for="order" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">Порядок (№)</label>
            <input type="number" id="order" name="order" min="1" value="<%= lesson ? (lesson.order || 1) : 1 %>"
                   class="block w-full px-4 py-2.5 bg-slate-50 border border-zinc-300 rounded-xl text-xs text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 transition font-mono">
          </div>

          <div class="sm:col-span-2">
            <label for="durationMinutes" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">Длительность (мин)</label>
            <input type="number" id="durationMinutes" name="durationMinutes" min="1" value="<%= lesson ? (lesson.durationMinutes || 15) : 15 %>"
                   class="block w-full px-4 py-2.5 bg-slate-50 border border-zinc-300 rounded-xl text-xs text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 transition font-mono">
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-1.5">Краткое описание урока</label>
          <input type="text" id="description" name="description" value="<%= lesson ? lesson.description : '' %>" placeholder="Краткая суть того, что ученик узнает в этом уроке..."
                 class="block w-full px-4 py-2.5 bg-slate-50 border border-zinc-300 rounded-xl text-xs text-zinc-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 transition">
        </div>

        <!-- YouTube Link Box -->
        <div class="p-5 rounded-2xl bg-zinc-950 text-white border border-zinc-800">
          <div class="flex items-center justify-between mb-2">
            <label for="videoUrl" class="text-xs font-bold uppercase tracking-wider text-orange-400 flex items-center gap-1.5">
              <i class="fa-brands fa-youtube text-base text-red-500"></i>
              <span>Ссылка на YouTube видео (Unlisted / Доступ по ссылке)</span>
            </label>
            <span class="text-[10px] text-zinc-400">Поддерживает shorts, watch, embed</span>
          </div>

          <input type="text" id="videoUrl" name="videoUrl" value="<%= lesson ? (lesson.videoUrl || '') : '' %>" placeholder="https://youtube.com/shorts/vLpVCVKySCE?feature=share"
                 class="block w-full px-4 py-2.5 bg-zinc-900 border border-zinc-700 rounded-xl text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-orange-500 font-mono transition">

          <div class="mt-2.5 flex items-center justify-between text-[11px] text-zinc-400">
            <span>🛡️ Видео будет автоматически защищено от перемотки вперед и скачивания.</span>
            <span id="detectedIdPreview" class="text-orange-400 font-mono font-bold">
              <%= lesson && lesson.youtubeId ? `ID: ${lesson.youtubeId}` : '' %>
            </span>
          </div>
        </div>

        <!-- Theory Editor -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="theory" class="text-xs font-bold uppercase tracking-wider text-zinc-700 flex items-center gap-1.5">
              <i class="fa-solid fa-file-code text-orange-600"></i>
              <span>Теоретический материал (Markdown)</span>
            </label>
            <span class="text-[11px] text-zinc-400">Поддерживает # заголовки, списки, блоки кода ```javascript</span>
          </div>
          
          <textarea id="theory" name="theory" rows="12" placeholder="# Заголовок темы&#10;&#10;Описание теории...&#10;&#10;```javascript&#10;console.log('Hello, Node.js!');&#10;```"
                    class="block w-full p-4 bg-slate-50 border border-zinc-300 rounded-xl text-xs text-zinc-900 font-mono focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500 transition leading-relaxed"><%= lesson ? (lesson.theory || '') : '' %></textarea>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
          <a href="/teacher/courses/<%= course.id %>/edit" class="px-5 py-2.5 rounded-xl text-xs font-semibold text-zinc-600 hover:bg-zinc-100 transition">Отмена</a>
          <button type="submit" class="bg-orange-600 hover:bg-orange-500 text-white font-bold px-6 py-2.5 rounded-xl text-xs shadow-lg shadow-orange-600/30 transition">
            <%= lesson && lesson.id ? 'Сохранить урок' : 'Опубликовать урок' %>
          </button>
        </div>

      </form>
    </div>

  </div>
</main>

<script>
  // Live YouTube link preview helper
  const input = document.getElementById('videoUrl');
  const preview = document.getElementById('detectedIdPreview');

  function parseYt(url) {
    if (!url) return '';
    const m = url.match(/(?:youtube\.com\/(?:shorts\/|watch\?(?:.*&)?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return m ? m[1] : (url.length === 11 ? url : '');
  }

  if (input && preview) {
    input.addEventListener('input', () => {
      const id = parseYt(input.value.trim());
      if (id) {
        preview.textContent = `Обнаружен ID видео: ${id}`;
        preview.className = 'text-green-400 font-mono font-bold';
      } else if (input.value.trim().length > 0) {
        preview.textContent = 'Проверьте формат ссылки';
        preview.className = 'text-amber-400 font-mono';
      } else {
        preview.textContent = '';
      }
    });
  }
</script>

<%- include('../partials/footer') %>
