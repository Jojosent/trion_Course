<%- include('../partials/header', { title: 'Кабинет преподавателя' }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-8 mb-8 border-b border-zinc-200 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-orange-600 mb-1">
          <i class="fa-solid fa-chalkboard-user"></i> Панель преподавателя
        </div>
        <h1 class="text-3xl font-extrabold text-zinc-900 tracking-tight">Управление курсами и уроками</h1>
      </div>

      <a href="/teacher/courses/new" class="bg-orange-600 hover:bg-orange-500 text-white font-bold px-5 py-3 rounded-xl text-xs shadow-lg shadow-orange-600/30 transition flex items-center justify-center gap-2 self-start sm:self-auto">
        <i class="fa-solid fa-plus"></i>
        <span>Создать новый курс</span>
      </a>
    </div>

    <!-- Courses Grid -->
    <div class="space-y-6">
      <% if (courses.length === 0) { %>
        <div class="bg-white rounded-3xl p-12 text-center border border-zinc-200">
          <div class="w-16 h-16 rounded-2xl bg-orange-100 text-orange-600 mx-auto flex items-center justify-center text-2xl mb-4">
            <i class="fa-solid fa-book-bookmark"></i>
          </div>
          <h3 class="text-lg font-bold text-zinc-900 mb-1">У вас пока нет созданных курсов</h3>
          <p class="text-xs text-zinc-500 mb-6">Создайте первый курс, добавьте теорию и видеоматериалы с YouTube.</p>
          <a href="/teacher/courses/new" class="inline-flex items-center gap-2 bg-orange-600 hover:bg-orange-500 text-white font-bold px-5 py-2.5 rounded-xl text-xs">
            <i class="fa-solid fa-plus"></i> Начать создание курса
          </a>
        </div>
      <% } %>

      <% courses.forEach(course => { %>
        <div class="bg-white rounded-2xl p-6 border border-zinc-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6 hover:border-orange-300 transition">
          
          <div class="flex items-start gap-4">
            <div class="w-20 h-20 rounded-xl overflow-hidden bg-zinc-900 flex-shrink-0">
              <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="w-full h-full object-cover">
            </div>

            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-bold uppercase bg-orange-100 text-orange-700 px-2 py-0.5 rounded">
                  <%= course.category %>
                </span>
                <span class="text-xs text-zinc-400">&bull;</span>
                <span class="text-xs text-zinc-500"><%= course.lessonsCount %> уроков</span>
              </div>

              <h2 class="text-base font-bold text-zinc-900 mb-1">
                <%= course.title %>
              </h2>
              <p class="text-xs text-zinc-500 line-clamp-2 max-w-xl">
                <%= course.description %>
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 flex-shrink-0">
            <a href="/courses/<%= course.id %>" target="_blank" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition flex items-center gap-1.5" title="Посмотреть как видит ученик">
              <i class="fa-solid fa-eye"></i>
              <span>Просмотр</span>
            </a>

            <a href="/teacher/courses/<%= course.id %>/lessons/new" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 transition flex items-center gap-1.5">
              <i class="fa-solid fa-plus"></i>
              <span>Добавить урок</span>
            </a>

            <a href="/teacher/courses/<%= course.id %>/edit" class="px-4 py-2 rounded-xl text-xs font-bold bg-dark-950 hover:bg-dark-800 text-white transition flex items-center gap-1.5">
              <i class="fa-solid fa-pen-to-square"></i>
              <span>Редактировать</span>
            </a>
          </div>

        </div>
      <% }) %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
