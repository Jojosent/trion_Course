<%- include('../partials/header', { title: 'Пользователи платформы' }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <a href="/admin" class="text-xs text-zinc-500 hover:text-orange-600 transition flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-left"></i> Назад в панель администратора
      </a>
      <span class="text-xs font-bold text-zinc-700 bg-white px-3 py-1 rounded-lg border border-zinc-200">
        Всего пользователей: <%= users.length %>
      </span>
    </div>

    <!-- USERS MANAGEMENT TABLE -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-zinc-200 text-zinc-400 uppercase text-[10px] font-bold tracking-wider">
              <th class="pb-3 px-3">Пользователь</th>
              <th class="pb-3 px-3">Email</th>
              <th class="pb-3 px-3">Текущая роль</th>
              <th class="pb-3 px-3">Изменить роль</th>
              <th class="pb-3 px-3 text-right">Действие</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            <% users.forEach(u => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3 px-3 font-bold text-zinc-900"><%= u.name %></td>
                <td class="py-3 px-3 font-mono text-zinc-600"><%= u.email %></td>
                <td class="py-3 px-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold <%= u.role === 'admin' ? 'bg-orange-100 text-orange-700' : (u.role === 'teacher' ? 'bg-amber-100 text-amber-800' : 'bg-zinc-100 text-zinc-700') %>">
                    <%= u.role %>
                  </span>
                </td>
                <td class="py-3 px-3">
                  <form action="/admin/users/<%= u.id %>/role" method="POST" class="flex items-center gap-2">
                    <select name="role" class="bg-slate-50 border border-zinc-300 rounded-lg px-2 py-1 text-xs">
                      <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>student</option>
                      <option value="teacher" <%= u.role === 'teacher' ? 'selected' : '' %>>teacher</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                    </select>
                    <button type="submit" class="bg-dark-900 text-white font-semibold px-2 py-1 rounded text-xs">OK</button>
                  </form>
                </td>
                <td class="py-3 px-3 text-right">
                  <% if (u.id !== currentUser.id) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Удалить?');" class="inline">
                      <button type="submit" class="text-red-600 hover:text-red-700 p-1"><i class="fa-solid fa-trash-can"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
