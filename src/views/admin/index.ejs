<%- include('../partials/header', { title: 'Панель администратора (Trion Admin)' }) %>
<%- include('../partials/navbar') %>

<main class="flex-grow py-10 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Admin Header -->
    <div class="bg-dark-950 text-white rounded-3xl p-8 mb-8 border border-dark-700 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-orange-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 bg-orange-950/60 border border-orange-500/40 px-3 py-1 rounded-full text-xs font-semibold text-orange-400 mb-3">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Прямой доступ /admin</span>
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight">Панель управления системой</h1>
          <p class="text-xs text-zinc-400 mt-1">Управление пользователями, ролями (admin, teacher, students), курсами и базой данных</p>
        </div>

        <!-- DB Status Badge -->
        <div class="flex items-center gap-3">
          <div class="bg-dark-900 border border-dark-700 px-4 py-2.5 rounded-2xl flex items-center gap-3">
            <div class="w-3 h-3 rounded-full <%= isFirebase ? 'bg-orange-500 animate-ping' : 'bg-emerald-500' %>"></div>
            <div>
              <div class="text-[10px] text-zinc-400 font-bold uppercase">Хранилище данных</div>
              <div class="text-xs font-bold <%= isFirebase ? 'text-orange-400' : 'text-emerald-400' %>">
                <%= isFirebase ? '🔥 Firebase Firestore Active' : '💾 Local JSON DB (Ready for Firebase)' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      
      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Всего юзеров</div>
        <div class="text-2xl font-black text-zinc-900 mt-1 font-mono"><%= stats.totalUsers %></div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Ученики</div>
        <div class="text-2xl font-black text-blue-600 mt-1 font-mono"><%= stats.studentsCount %></div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Учителя</div>
        <div class="text-2xl font-black text-amber-600 mt-1 font-mono"><%= stats.teachersCount %></div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Админы</div>
        <div class="text-2xl font-black text-orange-600 mt-1 font-mono"><%= stats.adminsCount %></div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Курсов</div>
        <div class="text-2xl font-black text-zinc-900 mt-1 font-mono"><%= stats.coursesCount %></div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-zinc-200 shadow-sm">
        <div class="text-[11px] font-bold uppercase text-zinc-400">Уроков</div>
        <div class="text-2xl font-black text-zinc-900 mt-1 font-mono"><%= stats.lessonsCount %></div>
      </div>

    </div>

    <!-- USERS MANAGEMENT TABLE -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm mb-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-zinc-100 gap-3">
        <div>
          <h2 class="text-lg font-bold text-zinc-900">Управление пользователями и ролями</h2>
          <p class="text-xs text-zinc-500">Вы можете назначить пользователю роль Учителя (teacher), Ученика (student) или Админа (admin)</p>
        </div>
        <span class="text-xs font-semibold text-zinc-600 bg-zinc-100 px-3 py-1 rounded-full">
          Пользователей: <%= users.length %>
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-zinc-200 text-zinc-400 uppercase text-[10px] font-bold tracking-wider">
              <th class="pb-3 px-3">Пользователь</th>
              <th class="pb-3 px-3">Email</th>
              <th class="pb-3 px-3">Текущая роль</th>
              <th class="pb-3 px-3">Изменить роль</th>
              <th class="pb-3 px-3 text-right">Действие</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            <% users.forEach(u => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3 px-3">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-dark-900 text-white flex items-center justify-center font-bold text-xs">
                      <%= u.name ? u.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <div class="font-bold text-zinc-900"><%= u.name %></div>
                      <div class="text-[10px] text-zinc-400 font-mono"><%= u.id %></div>
                    </div>
                  </div>
                </td>

                <td class="py-3 px-3 font-mono text-zinc-600">
                  <%= u.email %>
                </td>

                <td class="py-3 px-3">
                  <% if (u.role === 'admin') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-orange-100 text-orange-700 border border-orange-200">
                      <i class="fa-solid fa-shield text-[9px] mr-1"></i> admin
                    </span>
                  <% } else if (u.role === 'teacher') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                      <i class="fa-solid fa-chalkboard-user text-[9px] mr-1"></i> teacher
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-zinc-100 text-zinc-700 border border-zinc-200">
                      <i class="fa-solid fa-user text-[9px] mr-1"></i> student
                    </span>
                  <% } %>
                </td>

                <td class="py-3 px-3">
                  <form action="/admin/users/<%= u.id %>/role" method="POST" class="flex items-center gap-2">
                    <select name="role" class="bg-slate-50 border border-zinc-300 rounded-lg px-2.5 py-1 text-xs focus:ring-1 focus:ring-orange-500 outline-none">
                      <option value="student" <%= u.role === 'student' ? 'selected' : '' %>>student (Ученик)</option>
                      <option value="teacher" <%= u.role === 'teacher' ? 'selected' : '' %>>teacher (Учитель)</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin (Администратор)</option>
                    </select>
                    <button type="submit" class="bg-dark-900 hover:bg-dark-800 text-white font-semibold px-2.5 py-1 rounded-lg text-xs transition">
                      Сменить
                    </button>
                  </form>
                </td>

                <td class="py-3 px-3 text-right">
                  <% if (u.id !== currentUser.id) { %>
                    <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Удалить пользователя <%= u.name %>?');" class="inline">
                      <button type="submit" class="text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 p-1.5 rounded-lg transition" title="Удалить">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-[10px] text-zinc-400 italic">Текущий аккаунт</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- COURSES MODERATION TABLE -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-sm mb-10">
      <div class="flex items-center justify-between pb-6 mb-6 border-b border-zinc-100">
        <div>
          <h2 class="text-lg font-bold text-zinc-900">Модерация курсов платформы</h2>
          <p class="text-xs text-zinc-500">Просмотр и удаление курсов всех преподавателей</p>
        </div>
      </div>

      <div class="space-y-3">
        <% courses.forEach(c => { %>
          <div class="p-4 rounded-xl border border-zinc-200 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg overflow-hidden bg-zinc-900 flex-shrink-0">
                <img src="<%= c.thumbnail %>" alt="<%= c.title %>" class="w-full h-full object-cover">
              </div>
              <div>
                <div class="text-xs font-bold text-zinc-900"><%= c.title %></div>
                <div class="text-[10px] text-zinc-500">
                  Автор: <span class="font-semibold"><%= c.authorName %></span> &bull; <%= c.lessonsCount %> уроков &bull; <%= c.category %>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <a href="/courses/<%= c.id %>" target="_blank" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition">
                <i class="fa-solid fa-eye"></i>
              </a>
              <form action="/admin/courses/<%= c.id %>/delete" method="POST" onsubmit="return confirm('Удалить курс <%= c.title %>?');" class="inline">
                <button type="submit" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-red-600 hover:bg-red-50 transition" title="Удалить курс">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- FIREBASE CONNECTION GUIDE -->
    <div class="bg-dark-950 text-white rounded-3xl p-6 sm:p-8 border border-dark-700 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 rounded-xl bg-orange-600/20 text-orange-500 flex items-center justify-center text-lg">
          <i class="fa-solid fa-fire"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-white">Интеграция с Firebase Firestore</h3>
          <p class="text-[11px] text-zinc-400">Как переключить систему на ваше облачное хранилище Firebase</p>
        </div>
      </div>

      <div class="text-xs text-zinc-300 space-y-2 leading-relaxed bg-dark-900 p-4 rounded-2xl border border-dark-800 font-mono">
        <div>1. Создайте проект на <span class="text-orange-400">console.firebase.google.com</span> и включите Cloud Firestore.</div>
        <div>2. Перейдите в «Project Settings» -> «Service Accounts» и нажмите «Generate new private key».</div>
        <div>3. Скачайте файл и сохраните его в корне проекта под именем <span class="text-orange-400">serviceAccountKey.json</span>.</div>
        <div>4. Перезапустите сервер: Node.js автоматически подключится к облачной базе Firebase Firestore!</div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
