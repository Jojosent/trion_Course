<%- include('partials/header', { title: title }) %>
<%- include('partials/navbar') %>

<div class="bg-dark-950 text-white border-b border-dark-700 py-3.5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <a href="/courses/<%= course.id %>" class="text-zinc-400 hover:text-white text-xs flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Курс</span>
      </a>
      <span class="text-zinc-600">/</span>
      <span class="text-xs font-bold text-orange-400 truncate max-w-xs sm:max-w-md"><%= course.title %></span>
    </div>

    <!-- Status badge -->
    <div class="flex items-center gap-3">
      <% const isAlreadyCompleted = completedLessonIds.has(lesson.id); %>
      <div id="completionBadge" class="inline-flex items-center text-xs font-semibold px-3 py-1 rounded-full <%= isAlreadyCompleted ? 'bg-green-950 text-green-400 border border-green-800' : 'bg-dark-900 text-zinc-400 border border-dark-700' %>">
        <% if (isAlreadyCompleted) { %>
          <i class="fa-solid fa-circle-check text-green-500 mr-1.5"></i> Урок пройден
        <% } else { %>
          <i class="fa-regular fa-circle text-orange-500 mr-1.5"></i> В процессе изучения
        <% } %>
      </div>
    </div>
  </div>
</div>

<main class="flex-grow py-8 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- MAIN LESSON WORKSPACE (LEFT 8 COLUMNS) -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- Video Player Section (if video exists) -->
        <% if (lesson.youtubeId) { %>
          <div id="fullPlayerSection" class="bg-white p-4 sm:p-6 rounded-3xl border border-zinc-200 shadow-xl">
            
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-orange-500 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-800">Защищенный видеоурок</span>
              </div>
              <span class="text-[11px] font-medium text-orange-600 bg-orange-50 px-2.5 py-1 rounded-lg border border-orange-200">
                <i class="fa-solid fa-shield-halved mr-1"></i> Anti-Skip активен (только -5 сек)
              </span>
            </div>

            <!-- PLAYER CONTAINER WITH PROTECTIVE SHIELDS -->
            <div class="trion-player-container aspect-video relative" 
                 id="playerContainer" 
                 data-video-id="<%= lesson.youtubeId %>"
                 data-lesson-id="<%= lesson.id %>"
                 data-course-id="<%= course.id %>"
                 data-watched-seconds="<%= currentLessonProgress ? (currentLessonProgress.watchedSeconds || 0) : 0 %>">
              
              <!-- 1. YouTube Iframe Mount Node -->
              <div id="ytPlayerWrapper" class="trion-video-frame"></div>

              <!-- 2. Top Protective Shield (Blocks YouTube Title Bar, Share Button, Watch Later) -->
              <div class="player-shield-top"></div>

              <!-- 3. Bottom Right Protective Shield (Blocks YouTube Logo watermark) -->
              <div class="player-shield-bottom-right"></div>

              <!-- 4. Click-to-Play/Pause Overlay (Intercepts clicks so user never opens YouTube) -->
              <div class="player-click-overlay" id="clickOverlay" title="Нажмите для воспроизведения/паузы">
                <div class="big-play-btn" id="bigPlayBtn">
                  <i class="fa-solid fa-play ml-1"></i>
                </div>
              </div>

              <!-- 5. Toast Warning Notification -->
              <div class="player-toast" id="playerToast">
                <i class="fa-solid fa-shield-halved text-orange-500 text-base"></i>
                <span>Перемотка вперед заблокирована правилами курса!</span>
              </div>

            </div>

            <!-- CUSTOM CONTROLS BAR (STRICT NO FORWARD SCRUB, ONLY -5 SEC) -->
            <div class="bg-dark-950 border border-dark-700 rounded-2xl mt-4 p-4 shadow-lg flex flex-col gap-3">
              
              <!-- Watched Progress Indicator (Non-clickable / No forward seek) -->
              <div class="flex items-center gap-3">
                <div class="no-skip-progress-track" title="Перемотка вперед отключена. Прогресс заполняется по мере просмотра.">
                  <div class="no-skip-progress-bar" id="watchedProgressBar"></div>
                </div>
                <div class="text-[11px] font-mono font-semibold text-zinc-400 whitespace-nowrap min-w-[90px] text-right" id="timeDisplay">
                  00:00 / 00:00
                </div>
              </div>

              <!-- Action Controls Row -->
              <div class="flex flex-wrap items-center justify-between gap-3">
                
                <div class="flex items-center gap-2">
                  <!-- Play / Pause Button -->
                  <button type="button" id="btnPlayPause" class="bg-orange-600 hover:bg-orange-500 text-white font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-2 transition active:scale-95 shadow-md shadow-orange-600/30">
                    <i class="fa-solid fa-play" id="iconPlayPause"></i>
                    <span id="textPlayPause">Старт</span>
                  </button>

                  <!-- ⏪ REWIND 5 SECONDS BUTTON (AS SPECIFIED BY USER) -->
                  <button type="button" id="btnRewind5" class="btn-rewind bg-dark-900 hover:bg-dark-800 text-orange-400 hover:text-orange-300 font-bold px-3.5 py-2 rounded-xl text-xs flex items-center gap-1.5 transition border border-dark-700 active:scale-95" title="Повторить фрагмент (- 5 секунд)">
                    <i class="fa-solid fa-rotate-left text-xs"></i>
                    <span>- 5 сек</span>
                  </button>

                  <!-- Volume Control -->
                  <div class="hidden sm:flex items-center gap-2 pl-2 border-l border-dark-700">
                    <button type="button" id="btnMute" class="text-zinc-400 hover:text-white p-1.5 text-xs transition">
                      <i class="fa-solid fa-volume-high" id="iconVolume"></i>
                    </button>
                    <input type="range" id="volumeSlider" min="0" max="100" value="100" class="w-16 accent-orange-500 cursor-pointer">
                  </div>
                </div>

                <div class="flex items-center gap-2">
                  <!-- Speed Selector -->
                  <select id="speedSelect" class="bg-dark-900 border border-dark-700 text-zinc-300 text-xs rounded-xl px-2.5 py-2 focus:border-orange-500 outline-none">
                    <option value="1">1.0x (Норма)</option>
                    <option value="1.25">1.25x</option>
                    <option value="1.5">1.5x</option>
                  </select>

                  <!-- Fullscreen Button -->
                  <button type="button" id="btnFullscreen" class="bg-dark-900 hover:bg-dark-800 text-zinc-300 hover:text-white p-2 rounded-xl border border-dark-700 transition text-xs" title="На весь экран">
                    <i class="fa-solid fa-expand"></i>
                  </button>
                </div>

              </div>

            </div>

          </div>
        <% } %>

        <!-- Theory Section -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-zinc-200 shadow-sm">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-zinc-100">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center text-sm font-bold">
                <i class="fa-solid fa-book-open"></i>
              </div>
              <div>
                <h2 class="text-base font-bold text-zinc-900">Теоретический конспект</h2>
                <div class="text-[11px] text-zinc-500">Материалы урока, термины и примеры кода</div>
              </div>
            </div>

            <button type="button" onclick="manualMarkCompleted()" class="text-xs font-bold bg-dark-950 hover:bg-dark-800 text-white px-3.5 py-2 rounded-xl transition flex items-center gap-1.5">
              <i class="fa-solid fa-check text-green-400"></i>
              <span>Закрепить теорию</span>
            </button>
          </div>

          <!-- Rendered Theory Markdown Content -->
          <div class="theory-prose">
            <% if (renderedTheory) { %>
              <%- renderedTheory %>
            <% } else { %>
              <p class="text-zinc-500 text-xs italic">
                Для данного урока теоретический конспект еще не добавлен автором. Пожалуйста, посмотрите видеоматериал.
              </p>
            <% } %>
          </div>
        </div>

        <!-- Previous / Next Lesson Navigation -->
        <div class="flex items-center justify-between pt-4">
          <% if (prevLesson) { %>
            <a href="/lessons/<%= prevLesson.id %>" class="bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-800 font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-2 shadow-sm">
              <i class="fa-solid fa-arrow-left text-[11px]"></i>
              <span class="truncate max-w-[150px] sm:max-w-xs">Предыдущий: <%= prevLesson.title %></span>
            </a>
          <% } else { %>
            <div></div>
          <% } %>

          <% if (nextLesson) { %>
            <a href="/lessons/<%= nextLesson.id %>" class="bg-orange-600 hover:bg-orange-500 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition flex items-center gap-2 shadow-lg shadow-orange-600/30">
              <span class="truncate max-w-[150px] sm:max-w-xs">Следующий: <%= nextLesson.title %></span>
              <i class="fa-solid fa-arrow-right text-[11px]"></i>
            </a>
          <% } else { %>
            <a href="/courses/<%= course.id %>" class="bg-zinc-900 hover:bg-zinc-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition flex items-center gap-2 shadow-sm">
              <i class="fa-solid fa-flag-checkered text-orange-400"></i>
              <span>Завершить курс</span>
            </a>
          <% } %>
        </div>

      </div>

      <!-- RIGHT SIDEBAR (COURSE CURRICULUM OUTLINE, 4 COLUMNS) -->
      <div class="lg:col-span-4 space-y-6">
        
        <div class="bg-white p-6 rounded-3xl border border-zinc-200 shadow-sm sticky top-24">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100">
            <div>
              <div class="text-[10px] uppercase font-bold text-zinc-400">Навигация по курсу</div>
              <h3 class="text-sm font-bold text-zinc-900 truncate max-w-[200px]"><%= course.title %></h3>
            </div>
            <span class="text-xs font-mono font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded-md">
              <%= allLessons.findIndex(l => l.id === lesson.id) + 1 %> / <%= allLessons.length %>
            </span>
          </div>

          <div class="space-y-2 max-h-[500px] overflow-y-auto pr-1">
            <% allLessons.forEach((item, idx) => { %>
              <% const isCurrent = item.id === lesson.id; %>
              <% const isDone = completedLessonIds.has(item.id); %>
              
              <a href="/lessons/<%= item.id %>" class="p-3 rounded-xl block transition border text-xs <%= isCurrent ? 'bg-orange-50 border-orange-300 text-orange-950 font-bold' : (isDone ? 'bg-zinc-50 border-zinc-200 text-zinc-600 hover:bg-zinc-100' : 'bg-white border-zinc-200 text-zinc-700 hover:border-orange-200') %>">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2 truncate">
                    <span class="w-5 h-5 rounded-md <%= isDone ? 'bg-green-100 text-green-700' : (isCurrent ? 'bg-orange-600 text-white' : 'bg-zinc-200 text-zinc-700') %> flex items-center justify-center text-[10px] font-mono flex-shrink-0">
                      <% if (isDone) { %>
                        <i class="fa-solid fa-check"></i>
                      <% } else { %>
                        <%= idx + 1 %>
                      <% } %>
                    </span>
                    <span class="truncate <%= isCurrent ? 'text-orange-900 font-bold' : '' %>">
                      <%= item.title %>
                    </span>
                  </div>

                  <span class="text-[10px] text-zinc-400 flex-shrink-0 font-mono">
                    <%= item.durationMinutes || 10 %>м
                  </span>
                </div>
              </a>
            <% }) %>
          </div>

          <div class="mt-6 pt-4 border-t border-zinc-100 text-center">
            <a href="/courses/<%= course.id %>" class="text-xs font-semibold text-orange-600 hover:text-orange-700 flex items-center justify-center gap-1">
              <i class="fa-solid fa-list-check"></i>
              <span>Все материалы курса</span>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</main>

<script>
  async function manualMarkCompleted() {
    try {
      const res = await fetch('/api/progress/<%= lesson.id %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          courseId: '<%= course.id %>',
          completed: true,
          watchedSeconds: 9999
        })
      });
      const data = await res.json();
      if (data.success) {
        const badge = document.getElementById('completionBadge');
        if (badge) {
          badge.innerHTML = '<i class="fa-solid fa-circle-check text-green-500 mr-1.5"></i> Урок пройден';
          badge.className = 'inline-flex items-center text-xs font-semibold px-3 py-1 rounded-full bg-green-950 text-green-400 border border-green-800';
        }
        alert('Материал урока успешно закреплен!');
      }
    } catch (e) {
      console.error(e);
    }
  }
</script>

<!-- Custom Video Player Script -->
<script src="/js/player.js"></script>

<%- include('partials/footer') %>
