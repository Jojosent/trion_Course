<nav class="bg-dark-950 text-white border-b border-dark-700 sticky top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-600 to-orange-400 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-orange-600/30 group-hover:scale-105 transition-transform">
            T
          </div>
          <div>
            <div class="font-extrabold tracking-tight text-lg text-white leading-none flex items-center gap-1.5">
              <span>TRION</span>
              <span class="text-orange-500">ACADEMY</span>
            </div>
            <div class="text-[10px] text-zinc-400 font-medium tracking-wider uppercase">Курсы веб-разработки</div>
          </div>
        </a>

        <!-- Main Navigation Links -->
        <div class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href="/" class="text-zinc-300 hover:text-orange-400 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-house text-xs"></i> Главная
          </a>
          <a href="/courses" class="text-zinc-300 hover:text-orange-400 transition-colors flex items-center gap-1.5">
            <i class="fa-solid fa-book-open text-xs"></i> Каталог курсов
          </a>

          <!-- Teacher link if user is teacher or admin -->
          <% if (currentUser && (currentUser.role === 'teacher' || currentUser.role === 'admin')) { %>
            <a href="/teacher" class="text-orange-400 hover:text-orange-300 font-semibold transition-colors flex items-center gap-1.5 bg-orange-950/40 px-3 py-1.5 rounded-lg border border-orange-800/50">
              <i class="fa-solid fa-chalkboard-user text-xs"></i> Кабинет преподавателя
            </a>
          <% } %>
        </div>
      </div>

      <!-- Right Side: User Profile / Auth Actions -->
      <!-- Note: As requested by user, no "Admin" button is shown here on the public interface. /admin is accessed directly via URL -->
      <div class="flex items-center gap-4">
        <% if (currentUser) { %>
          <div class="flex items-center gap-3">
            <!-- User Info Badge -->
            <div class="flex items-center gap-2.5 bg-dark-900 border border-dark-700 py-1.5 px-3 rounded-xl">
              <div class="w-8 h-8 rounded-lg bg-orange-600/20 text-orange-400 flex items-center justify-center font-bold text-sm border border-orange-500/30">
                <%= currentUser.name.charAt(0).toUpperCase() %>
              </div>
              <div class="text-left hidden sm:block">
                <div class="text-xs font-bold text-zinc-100 truncate max-w-[140px]"><%= currentUser.name %></div>
                <div class="text-[10px] text-zinc-400 flex items-center gap-1">
                  <% if (currentUser.role === 'admin') { %>
                    <span class="text-orange-400 font-semibold"><i class="fa-solid fa-shield-halved text-[9px]"></i> Администратор</span>
                  <% } else if (currentUser.role === 'teacher') { %>
                    <span class="text-amber-400 font-semibold"><i class="fa-solid fa-graduation-cap text-[9px]"></i> Преподаватель</span>
                  <% } else { %>
                    <span class="text-zinc-400"><i class="fa-solid fa-user text-[9px]"></i> Ученик</span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Logout Button -->
            <a href="/logout" class="text-xs font-semibold text-zinc-400 hover:text-white bg-dark-900 hover:bg-dark-800 border border-dark-700 px-3 py-2 rounded-xl transition flex items-center gap-1.5" title="Выйти из аккаунта">
              <i class="fa-solid fa-arrow-right-from-bracket"></i>
              <span class="hidden md:inline">Выйти</span>
            </a>
          </div>
        <% } else { %>
          <div class="flex items-center gap-2.5">
            <a href="/login" class="text-xs font-bold text-zinc-200 hover:text-white px-3.5 py-2 rounded-xl hover:bg-dark-900 transition border border-transparent hover:border-dark-700">
              Войти
            </a>
            <a href="/register" class="text-xs font-bold text-white bg-orange-600 hover:bg-orange-500 px-4 py-2 rounded-xl shadow-lg shadow-orange-600/25 transition active:scale-95 flex items-center gap-1.5">
              <span>Регистрация</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</nav>
